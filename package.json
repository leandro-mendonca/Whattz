{
  "name": "whattz",
  "version": "1.1.0",
  "description": "Aplicativo desktop para controle diário de consumo de energia elétrica e cálculo de fatura (Enel RJ / Maricá)",
  "main": "src/main/main.js",
  "homepage": "https://github.com/leandro-mendonca/Whattz",
  "author": {
    "name": "Leandro Mendonça",
    "email": "leandromendonca1977@gmail.com",
    "url": "https://github.com/leandro-mendonca"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node src/main/web-server.js",
    "test": "node test/calculator.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -wl",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis zip"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.whattz.energia",
    "productName": "Whattz - Controle de Energia",
    "copyright": "Copyright © 2026 Leandro Mendonça",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "linux": {
      "icon": "assets/icon.png",
      "executableName": "whattz",
      "executableArgs": [
        "--no-sandbox",
        "--class=whattz"
      ],
      "desktop": {
        "StartupWMClass": "whattz"
      },
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Controle diário de consumo de energia elétrica (Maricá / Enel RJ)",
      "vendor": "Leandro Mendonça",
      "maintainer": "Leandro Mendonça <leandromendonca1977@gmail.com>"
    },
    "win": {
      "icon": "assets/icon.ico",
      "publisherName": "Leandro Mendonça",
      "legalTrademarks": "Copyright © 2026 Leandro Mendonça",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Whattz Energia"
    }
  }
}
